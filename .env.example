OPENAI_API_KEY=

# OpenAI Realtime defaults. Keep gpt-realtime unless you intentionally upgrade.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Shared encrypted cookie secret for MCP OAuth sessions.
# NOTION_COOKIE_SECRET is still accepted for backwards compatibility.
MCP_COOKIE_SECRET=

# Hosted Notion MCP over Streamable HTTP.
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_COOKIE_SECRET=
NOTION_MCP_ACCESS_TOKEN=

# Destination for pages created by the Notion MCP server.
# The bridge passes this through to the MCP tool payload.
NOTION_PARENT_PAGE_ID=

# Optional: override Notion MCP tool names if your MCP server exposes different names.
NOTION_MCP_CREATE_PAGE_TOOL=notion-create-pages
NOTION_MCP_APPEND_NOTE_TOOL=notion-update-page
NOTION_MCP_LIST_RECENT_TOOL=notion-search
NOTION_MCP_FETCH_TOOL=notion-fetch

# Google Calendar MCP over Streamable HTTP.
# This must be an MCP server URL, not a direct Google Calendar API URL.
# Defaults to https://gcal.mintmcp.com/mcp
GOOGLE_CALENDAR_MCP_URL=https://gcal.mintmcp.com/mcp
GOOGLE_CALENDAR_MCP_AUTH_SERVER=
GOOGLE_CALENDAR_MCP_CLIENT_ID=
GOOGLE_CALENDAR_MCP_CLIENT_SECRET=
GOOGLE_CALENDAR_MCP_SCOPE=
GOOGLE_CALENDAR_MCP_CREATE_EVENT_TOOL=
GOOGLE_CALENDAR_MCP_LIST_EVENTS_TOOL=
